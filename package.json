{
  "name": "coverage-lens",
  "displayName": "Coverage Lens: Who Tests This",
  "description": "Shows which tests reach each C++ function, from a per-test coverage database (coverage_db.py), and which tests to run for a change, a commit or a branch.",
  "version": "0.1.0",
  "publisher": "ericmarchand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/e-marchand/coverage-lens.git"
  },
  "bugs": {
    "url": "https://github.com/e-marchand/coverage-lens/issues"
  },
  "homepage": "https://github.com/e-marchand/coverage-lens#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Testing",
    "Visualization"
  ],
  "keywords": [
    "coverage",
    "test selection",
    "llvm-cov",
    "4D"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, the database and the run command come from user settings only.",
      "restrictedConfigurations": [
        "coverageLens.database",
        "coverageLens.runCommand"
      ]
    }
  },
  "contributes": {
    "configuration": {
      "title": "Coverage Lens",
      "properties": {
        "coverageLens.database": {
          "type": "string",
          "default": "",
          "markdownDescription": "The per-test coverage database made by `coverage_db.py ingest`: a file path (`~` and `${workspaceFolder}` allowed) or an `http(s)://` URL, downloaded once and again only when the server has a newer one. Run **Coverage Lens: Select Coverage Database…** to pick it.",
          "scope": "machine-overridable"
        },
        "coverageLens.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show above each function how many tests reach it, and which."
        },
        "coverageLens.currentLine": {
          "type": "boolean",
          "default": true,
          "description": "Show at the end of the current line the tests reaching its function, like a git blame."
        },
        "coverageLens.gutter": {
          "type": "boolean",
          "default": false,
          "description": "Color the gutter by function: green when a test reaches it, grey when only 4D startup does, red when nothing does."
        },
        "coverageLens.inlineTestNames": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "How many test names the CodeLens and the current line annotation show before \"+N\"."
        },
        "coverageLens.baseBranch": {
          "type": "string",
          "default": "origin/main",
          "description": "The branch \"Tests for Branch Changes\" compares with (from the merge base)."
        },
        "coverageLens.ignorePattern": {
          "type": "string",
          "default": "(ThirdParty|/Applications/Xcode|/usr/include|SDKs)",
          "description": "Database paths left out of test selection, as coverage_db.py does (a regular expression)."
        },
        "coverageLens.runCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "A shell command to run tests in a terminal: `${tests}` becomes the names separated by spaces, `${testsComma}` by commas. Empty: tests are only copied.",
          "scope": "machine-overridable"
        }
      }
    },
    "commands": [
      {
        "command": "coverageLens.selectDatabase",
        "title": "Select Coverage Database…",
        "category": "Coverage Lens",
        "icon": "$(database)"
      },
      {
        "command": "coverageLens.reload",
        "title": "Reload Coverage Database",
        "category": "Coverage Lens",
        "icon": "$(refresh)"
      },
      {
        "command": "coverageLens.info",
        "title": "Show Database Info",
        "category": "Coverage Lens"
      },
      {
        "command": "coverageLens.showUnitTests",
        "title": "Tests for Function at Cursor…",
        "category": "Coverage Lens"
      },
      {
        "command": "coverageLens.copyUnitTests",
        "title": "Copy Tests for Function at Cursor",
        "category": "Coverage Lens"
      },
      {
        "command": "coverageLens.selectWorkingTree",
        "title": "Tests for Working Tree Changes",
        "category": "Coverage Lens",
        "icon": "$(beaker)"
      },
      {
        "command": "coverageLens.selectStaged",
        "title": "Tests for Staged Changes",
        "category": "Coverage Lens"
      },
      {
        "command": "coverageLens.selectCommit",
        "title": "Tests for a Commit…",
        "category": "Coverage Lens",
        "icon": "$(git-commit)"
      },
      {
        "command": "coverageLens.selectBranch",
        "title": "Tests for Branch Changes",
        "category": "Coverage Lens",
        "icon": "$(git-branch)"
      },
      {
        "command": "coverageLens.selectFile",
        "title": "Tests for Current File",
        "category": "Coverage Lens",
        "icon": "$(file-code)"
      },
      {
        "command": "coverageLens.clearSelection",
        "title": "Clear",
        "category": "Coverage Lens",
        "icon": "$(clear-all)"
      },
      {
        "command": "coverageLens.copySelectionTests",
        "title": "Copy Test Names",
        "category": "Coverage Lens",
        "icon": "$(copy)"
      },
      {
        "command": "coverageLens.copySelectionMarkdown",
        "title": "Copy as Markdown Report",
        "category": "Coverage Lens",
        "icon": "$(markdown)"
      },
      {
        "command": "coverageLens.runSelectionTests",
        "title": "Run Tests",
        "category": "Coverage Lens",
        "icon": "$(play)"
      },
      {
        "command": "coverageLens.copyFunctionTests",
        "title": "Copy Test Names",
        "category": "Coverage Lens",
        "icon": "$(copy)"
      },
      {
        "command": "coverageLens.runFunctionTests",
        "title": "Run Tests",
        "category": "Coverage Lens",
        "icon": "$(play)"
      },
      {
        "command": "coverageLens.copyTestName",
        "title": "Copy Test Name",
        "category": "Coverage Lens",
        "icon": "$(copy)"
      },
      {
        "command": "coverageLens.runTest",
        "title": "Run Test",
        "category": "Coverage Lens",
        "icon": "$(play)"
      },
      {
        "command": "coverageLens.openUnit",
        "title": "Open Function",
        "category": "Coverage Lens"
      },
      {
        "command": "coverageLens.toggleGutter",
        "title": "Toggle Gutter Colors",
        "category": "Coverage Lens"
      },
      {
        "command": "coverageLens.toggleCurrentLine",
        "title": "Toggle Current Line Annotation",
        "category": "Coverage Lens"
      },
      {
        "command": "coverageLens.toggleCodeLens",
        "title": "Toggle CodeLens",
        "category": "Coverage Lens"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coverageLens",
          "title": "Coverage Lens",
          "icon": "media/beaker.svg"
        }
      ]
    },
    "views": {
      "coverageLens": [
        {
          "id": "coverageLens.function",
          "name": "Function at Cursor"
        },
        {
          "id": "coverageLens.changes",
          "name": "Tests for Changes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "coverageLens.function",
        "contents": "No coverage database loaded.\n[Select Coverage Database…](command:coverageLens.selectDatabase)\nA file path or an http(s) URL of the .sqlite made by coverage_db.py.",
        "when": "!coverageLens.hasDatabase"
      },
      {
        "view": "coverageLens.function",
        "contents": "Put the cursor in a C++ function to see the tests that reach it beyond 4D startup.",
        "when": "coverageLens.hasDatabase"
      },
      {
        "view": "coverageLens.changes",
        "contents": "Which tests should run for a change?\n[Working Tree Changes](command:coverageLens.selectWorkingTree)\n[A Commit…](command:coverageLens.selectCommit)\n[Branch Changes](command:coverageLens.selectBranch)\n[Staged Changes](command:coverageLens.selectStaged)\n[Current File](command:coverageLens.selectFile)",
        "when": "coverageLens.hasDatabase"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "coverageLens.copyFunctionTests",
          "when": "view == coverageLens.function",
          "group": "navigation@1"
        },
        {
          "command": "coverageLens.runFunctionTests",
          "when": "view == coverageLens.function && config.coverageLens.runCommand",
          "group": "navigation@2"
        },
        {
          "command": "coverageLens.selectDatabase",
          "when": "view == coverageLens.function",
          "group": "1_database@1"
        },
        {
          "command": "coverageLens.reload",
          "when": "view == coverageLens.function",
          "group": "1_database@2"
        },
        {
          "command": "coverageLens.info",
          "when": "view == coverageLens.function",
          "group": "1_database@3"
        },
        {
          "command": "coverageLens.toggleCodeLens",
          "when": "view == coverageLens.function",
          "group": "2_display@1"
        },
        {
          "command": "coverageLens.toggleCurrentLine",
          "when": "view == coverageLens.function",
          "group": "2_display@2"
        },
        {
          "command": "coverageLens.toggleGutter",
          "when": "view == coverageLens.function",
          "group": "2_display@3"
        },
        {
          "command": "coverageLens.selectWorkingTree",
          "when": "view == coverageLens.changes",
          "group": "navigation@1"
        },
        {
          "command": "coverageLens.selectCommit",
          "when": "view == coverageLens.changes",
          "group": "navigation@2"
        },
        {
          "command": "coverageLens.selectBranch",
          "when": "view == coverageLens.changes",
          "group": "navigation@3"
        },
        {
          "command": "coverageLens.copySelectionTests",
          "when": "view == coverageLens.changes",
          "group": "navigation@4"
        },
        {
          "command": "coverageLens.runSelectionTests",
          "when": "view == coverageLens.changes && config.coverageLens.runCommand",
          "group": "navigation@5"
        },
        {
          "command": "coverageLens.selectStaged",
          "when": "view == coverageLens.changes",
          "group": "1_select@1"
        },
        {
          "command": "coverageLens.selectFile",
          "when": "view == coverageLens.changes",
          "group": "1_select@2"
        },
        {
          "command": "coverageLens.copySelectionMarkdown",
          "when": "view == coverageLens.changes",
          "group": "2_copy@1"
        },
        {
          "command": "coverageLens.clearSelection",
          "when": "view == coverageLens.changes",
          "group": "2_copy@2"
        }
      ],
      "view/item/context": [
        {
          "command": "coverageLens.copyTestName",
          "when": "viewItem == test",
          "group": "inline@1"
        },
        {
          "command": "coverageLens.runTest",
          "when": "viewItem == test && config.coverageLens.runCommand",
          "group": "inline@2"
        },
        {
          "command": "coverageLens.copyTestName",
          "when": "viewItem == test",
          "group": "1_test@1"
        },
        {
          "command": "coverageLens.runTest",
          "when": "viewItem == test && config.coverageLens.runCommand",
          "group": "1_test@2"
        }
      ],
      "scm/title": [
        {
          "command": "coverageLens.selectWorkingTree",
          "when": "scmProvider == git && coverageLens.hasDatabase",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "command": "coverageLens.showUnitTests",
          "when": "coverageLens.hasDatabase && resourceScheme == file",
          "group": "coverageLens@1"
        }
      ],
      "commandPalette": [
        {
          "command": "coverageLens.copyFunctionTests",
          "when": "false"
        },
        {
          "command": "coverageLens.runFunctionTests",
          "when": "false"
        },
        {
          "command": "coverageLens.copyTestName",
          "when": "false"
        },
        {
          "command": "coverageLens.runTest",
          "when": "false"
        },
        {
          "command": "coverageLens.openUnit",
          "when": "false"
        },
        {
          "command": "coverageLens.clearSelection",
          "when": "false"
        },
        {
          "command": "coverageLens.copySelectionTests",
          "when": "coverageLens.hasDatabase"
        },
        {
          "command": "coverageLens.copySelectionMarkdown",
          "when": "coverageLens.hasDatabase"
        },
        {
          "command": "coverageLens.runSelectionTests",
          "when": "config.coverageLens.runCommand"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.0"
  }
}
